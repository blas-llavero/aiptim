{
  "manifest_version": 3,
  "name": "AIPTIM — ChatGPT Conversation Time Tracker",
  "version": "0.3.0",
  "description": "Automatically estimate time from Chrome's ChatGPT history and measure active conversation time locally. History access is optional.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "history"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://platform.openai.com/playground/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AIPTIM — conversation activity",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
